% ca-common.sty — shared style for all Computer Algebra course materials.
%
% pdfLaTeX + T2A/utf8, Russian typography, theorem-like environments,
% "check yourself" questions and number-theory / crypto math macros.
%
% Options:
%   notheorems  — do not define theorem-like environments (beamer defines its own)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ca-common}[2026/10/13 Computer Algebra course common style]

\newif\ifca@theorems \ca@theoremstrue
\DeclareOption{notheorems}{\ca@theoremsfalse}
\ProcessOptions\relax

% --- Encoding & language ----------------------------------------------------
\RequirePackage{cmap}
\RequirePackage[T1,T2A]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[english,russian]{babel}
% U+2212 MINUS SIGN (e.g. «p − 1» in titles from course.yaml)
\DeclareUnicodeCharacter{2212}{\ensuremath{-}}
% Greek letters in titles taken from course.yaml (e.g. «ρ-алгоритм»)
\DeclareUnicodeCharacter{03C1}{\ensuremath{\rho}}
\DeclareUnicodeCharacter{03BB}{\ensuremath{\lambda}}

% --- Reproducible PDFs ------------------------------------------------------------
% No path-dependent trailer /ID; dates come from SOURCE_DATE_EPOCH (latex image).
\ifdefined\pdftrailerid\pdftrailerid{}\fi

% --- Mathematics ------------------------------------------------------------
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mathtools}
\@ifclassloaded{beamer}{}{\RequirePackage{amsthm}}

% --- General utilities ------------------------------------------------------
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\@ifclassloaded{beamer}{}{%
  \RequirePackage{enumitem}%
  \setlist{itemsep=0.25em,topsep=0.4em}%
}

% --- Colors (shared with the beamer theme) ----------------------------------
\definecolor{caBlue}{HTML}{1F3A93}
\definecolor{caRed}{HTML}{B22222}
\definecolor{caGray}{HTML}{5A5A5A}
\definecolor{caLight}{HTML}{EEF1F8}

% --- Number sets & structures -----------------------------------------------
\newcommand{\NN}{\mathbb{N}}
\newcommand{\ZZ}{\mathbb{Z}}
\newcommand{\QQ}{\mathbb{Q}}
\newcommand{\RR}{\mathbb{R}}
\newcommand{\CC}{\mathbb{C}}
\newcommand{\FF}{\mathbb{F}}
% \Zn{n} -> Z/nZ ; \Znx{n} -> (Z/nZ)^*
\newcommand{\Zn}[1]{\ZZ/#1\ZZ}
\newcommand{\Znx}[1]{(\ZZ/#1\ZZ)^{*}}
% \GF{q} -> F_q
\newcommand{\GF}[1]{\FF_{#1}}

% --- Congruences --------------------------------------------------------------
% \Mod{m} -> " (mod m)" with the spacing used throughout the course materials
\newcommand{\Mod}[1]{\ (\mathrm{mod}\ #1)}
% \congr{a}{b}{m} -> a ≡ b (mod m)
\newcommand{\congr}[3]{#1 \equiv #2\Mod{#3}}

% --- Operators ----------------------------------------------------------------
\DeclareMathOperator{\ord}{ord}
\DeclareMathOperator{\lcm}{lcm}
\DeclareMathOperator{\Log}{Log}
\DeclareMathOperator{\ind}{ind}
\DeclareMathOperator{\disc}{disc}
\DeclareMathOperator{\HR}{HR}
\DeclareMathOperator{\Span}{span}
\DeclareMathOperator{\charac}{char}
\providecommand{\bigO}{\mathcal{O}}
\providecommand{\softO}{\widetilde{\mathcal{O}}}

% --- Delimiters ---------------------------------------------------------------
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\DeclarePairedDelimiter{\floor}{\lfloor}{\rfloor}
\DeclarePairedDelimiter{\ceil}{\lceil}{\rceil}
\DeclarePairedDelimiter{\round}{\lfloor}{\rceil}
\DeclarePairedDelimiter{\scal}{\langle}{\rangle}
% Legendre / Jacobi symbol: \legendre{a}{p}
\newcommand{\legendre}[2]{\left(\frac{#1}{#2}\right)}
\let\jacobi\legendre

% --- Crypto / lattices ----------------------------------------------------------
\newcommand{\Lat}{\mathcal{L}}
\newcommand{\EC}{E}                       % elliptic curve
\newcommand{\ECpt}{\mathcal{O}}           % point at infinity
\newcommand{\bits}[1]{\{0,1\}^{#1}}
% \vect{a}{b} -> column vector (a, b)^T
\newcommand{\vect}[2]{\begin{pmatrix}#1 \\ #2\end{pmatrix}}

% --- Theorem-like environments -------------------------------------------------
% Numbered within sections when the class has sections; beamer has its own.
\ifca@theorems
% Every environment below starts its paragraph at once (\leavevmode). Otherwise a
% theorem that begins with a list (enumerate, algorithmic) loses the hyperref anchor
% of its heading, and \ref/links to it point nowhere.
\newcommand{\ca@newtheorem}[3]{% {env}{shared counter or empty}{name}
  \ifx\relax#2\relax\newtheorem{ca@thm@#1}{#3}\else\newtheorem{ca@thm@#1}[#2]{#3}\fi
  \NewDocumentEnvironment{#1}{o}{%
    \IfNoValueTF{##1}{\begin{ca@thm@#1}}{\begin{ca@thm@#1}[{##1}]}\leavevmode
  }{\end{ca@thm@#1}}%
}
\@ifclassloaded{beamer}{}{%
  \theoremstyle{plain}
  \@ifundefined{c@section}{%
    \newtheorem{theorem}{Теорема}%
  }{%
    \newtheorem{theorem}{Теорема}[section]%
  }
  % `theorem` itself owns the counter; wrap it like the others
  \let\ca@thm@theorem\theorem \let\endca@thm@theorem\endtheorem
  \let\theorem\relax \let\endtheorem\relax
  \NewDocumentEnvironment{theorem}{o}{%
    \IfNoValueTF{#1}{\begin{ca@thm@theorem}}{\begin{ca@thm@theorem}[{#1}]}\leavevmode
  }{\end{ca@thm@theorem}}
  \ca@newtheorem{lemma}{theorem}{Лемма}
  \ca@newtheorem{corollary}{theorem}{Следствие}
  \ca@newtheorem{proposition}{theorem}{Утверждение}
  \theoremstyle{definition}
  \ca@newtheorem{definition}{theorem}{Определение}
  \ca@newtheorem{example}{theorem}{Пример}
  \ca@newtheorem{algorithm}{theorem}{Алгоритм}
  \ca@newtheorem{exercise}{theorem}{Упражнение}
  \theoremstyle{remark}
  \ca@newtheorem{remark}{theorem}{Замечание}
  \newtheorem*{note}{Примечание}
}
\fi

% --- Pseudocode -------------------------------------------------------------------
% algorithmicx (algpseudocode) with Russian keywords and no "end" lines; use it
% inside the theorem-like `algorithm` environment:
%   \begin{algorithm}[Евклид] \begin{algorithmic}[1] ... \end{algorithmic} \end{algorithm}
\RequirePackage[noend]{algpseudocode}
\algrenewcommand\algorithmicrequire{\textbf{Вход:}}
\algrenewcommand\algorithmicensure{\textbf{Выход:}}
\algrenewcommand\algorithmicif{\textbf{если}}
\algrenewcommand\algorithmicthen{\textbf{то}}
\algrenewcommand\algorithmicelse{\textbf{иначе}}
\algrenewcommand\algorithmicfor{\textbf{для}}
\algrenewcommand\algorithmicforall{\textbf{для всех}}
\algrenewcommand\algorithmicdo{}
\algrenewcommand\algorithmicwhile{\textbf{пока}}
\algrenewcommand\algorithmicrepeat{\textbf{повторять}}
\algrenewcommand\algorithmicloop{\textbf{повторять}}
\algrenewcommand\algorithmicuntil{\textbf{пока не}}
\algrenewcommand\algorithmicreturn{\textbf{вернуть}}
\algrenewcommand\algorithmicfunction{\textbf{функция}}
\algrenewcommand\algorithmicprocedure{\textbf{процедура}}
\algrenewcommand\algorithmiccomment[1]{\hfill\textcolor{caGray}{\(\triangleright\)~#1}}
\algnewcommand\Stop{\State \textbf{стоп}}

% --- "Check yourself" questions ----------------------------------------------
% \checkyourself{question} — typesets a highlighted, numbered question in place
% and collects it (with a page reference back to it); \printcheckyourself prints
% every question collected since the last \ca@resetcheckyourself (lecture notes
% reset at each lecture, so a book of several lectures keeps them per chapter).
% \ca@cyqprefix makes labels/anchors unique when several lectures share a document.
\newcounter{checkyourself}
\newcommand{\ca@cylist}{}
\newcommand{\ca@cyqprefix}{}
\newcommand{\theHcheckyourself}{\ca@cyqprefix\arabic{checkyourself}}
\newcommand{\checkyourselfname}{Проверь себя}
\newcommand{\ca@resetcheckyourself}{\setcounter{checkyourself}{0}\gdef\ca@cylist{}}
\newcommand{\checkyourself}[1]{%
  \refstepcounter{checkyourself}%
  \edef\ca@cyqlabel{cyq:\ca@cyqprefix\arabic{checkyourself}}%
  \par\medskip\noindent
  \colorbox{caLight}{\parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
    \expandafter\label\expandafter{\ca@cyqlabel}%
    \textcolor{caBlue}{\textbf{\checkyourselfname~\thecheckyourself.}}~#1}}%
  \par\medskip
  \begingroup\edef\x{\endgroup
    \noexpand\g@addto@macro\noexpand\ca@cylist{%
      \noexpand\ca@cyitem{\thecheckyourself}{\ca@cyqlabel}{\unexpanded{#1}}}}\x
}
\newcommand{\ca@cyitem}[3]{%
  \item[\textbf{#1.}]#3\nobreak\hfill\nobreak{\small\textcolor{caGray}{(с.~\pageref{#2})}}}
\newcommand{\printcheckyourself}{%
  \ifx\ca@cylist\@empty
    \textit{(вопросов нет)}%
  \else
    \begin{list}{}{\setlength{\leftmargin}{2em}\setlength{\labelwidth}{1.6em}}
      \ca@cylist
    \end{list}%
  \fi
}

\endinput
