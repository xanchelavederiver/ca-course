% ca-exam.cls — exam (зачёт / экзамен) question sheets.
%
% One source produces both PDFs: the plain question list and the variant
% with references (option `refs`). The body (questions-body.tex) is generated by
% `taskgen exam render` from questions.yaml; do not write it by hand.
%
%   \examtitle[<genitive>]{<title>}{<date>}
%       e.g. [вопросов на зачёт]{Вопросы на зачёт}{декабрь 2026}
%   \examliterature{key1,key2,...}  — the numbered literature list (shown only with `refs`):
%       the entries of latex/ca-refs.bib in this order (biblatex, \nocite), so the numbers
%       are fixed by the list, not by the order of citation
%   \topic{<topic title>}           — topic heading; numbering continues
%   \question{<n>}{<text>}{<refs>}  — question number n; refs (\cite[loc]{key}, free text)
%                                     shown only with `refs`
%   \begin{questiongroup}{<first>}{<last>}{<refs>} \qpart{<text>} ... \end{questiongroup}
%       a combined question «14-15»: with `refs`, one item «14–15» whose parts are
%       paragraphs; without, one numbered item per part (first, first+1, ...)
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{ca-exam}[2026/10/14 Computer Algebra exam questions]

\newif\ifrefs \refsfalse
\DeclareOption{refs}{\refstrue}
\DeclareOption*{\PassOptionsToClass{\CurrentOption}{extarticle}}
\PassOptionsToClass{12pt,a4paper}{extarticle}
\ProcessOptions\relax
\LoadClass{extarticle}

\RequirePackage[notheorems]{ca-common}
\RequirePackage[a4paper,width=170mm,top=18mm,bottom=20mm]{geometry}
\ifrefs\RequirePackage{ca-biblio}\fi
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=blue,urlcolor=magenta,citecolor=blue}
\RequirePackage{xurl}
\pagestyle{plain}
\setlength{\parindent}{0pt}
\DeclareUnicodeCharacter{263A}{\ensuremath{\ddot\smile}}% ☺ (free-text references)

\newcommand{\coursename}{Компьютерная алгебра}

\newcommand{\examtitle}[3][]{%
  \begin{center}
    \ifrefs
      {\Large\bfseries Ссылки на источники для\\[0.2em]
       \ifx\relax#1\relax #2\else #1\fi\ по курсу \coursename}%
    \else
      {\Large\bfseries #2 по курсу \coursename}%
    \fi
    \par\smallskip
    {\normalsize #3}
  \end{center}\medskip
}

\ifrefs
  \defbibheading{examlit}[\bibname]{\subsection*{#1}}
  \newcommand{\examliterature}[1]{%
    \nocite{#1}%
    \printbibliography[heading=examlit,title={Литература}]}
\else
  \newcommand{\examliterature}[1]{}
\fi

% width of the number column: «14–15.» needs more room than «7.»
\newlength{\examnumwidth}
\setlength{\examnumwidth}{\ifrefs 3.2em\else 2em\fi}

\newcommand{\topic}[1]{%
  \par\bigskip{\raggedright\large\bfseries #1\par}\nobreak\smallskip}

% one numbered paragraph: number #1, text #2
\newcommand{\ca@qitem}[2]{%
  \par\noindent\hangindent=\examnumwidth\hangafter=1
  \makebox[\examnumwidth][l]{#1.}#2\par}
% continuation paragraph at the text column
\newcommand{\ca@qcont}[1]{%
  \par\noindent\hangindent=\examnumwidth\hangafter=0 #1\par}
\newcommand{\ca@qrefs}[1]{%
  \ifrefs\nobreak\ca@qcont{\textcolor{caGray}{#1}}\fi\smallskip}

\newcommand{\question}[3]{\ca@qitem{#1}{#2}\ca@qrefs{#3}}

\newcounter{examqpart}
\newif\ifca@qfirst
\newenvironment{questiongroup}[3]{%
  \setcounter{examqpart}{#1}\ca@qfirsttrue
  \def\ca@qgroupnum{#1--#2}\def\ca@qgrouprefs{#3}%
}{%
  \ifrefs\ca@qrefs{\ca@qgrouprefs}\fi
}
\newcommand{\qpart}[1]{%
  \ifrefs
    \ifca@qfirst\ca@qitem{\ca@qgroupnum}{#1}\else\ca@qcont{#1}\fi
  \else
    \ca@qitem{\arabic{examqpart}}{#1}\smallskip
  \fi
  \stepcounter{examqpart}\ca@qfirstfalse}

\endinput
